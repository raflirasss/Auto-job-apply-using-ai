# Copy to .env and fill in. Never commit .env.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Password for dashboard login (min 8 chars)
DASHBOARD_PASSWORD=

# PostgreSQL (recommended):
#   DATABASE_URL=postgresql+psycopg://jobhunter:password@localhost:5432/jobhunter
# Local fallback when PostgreSQL is not installed (default if unset):
#   DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL=

# AI provider (OpenAI-compatible endpoint, e.g. Claude-compatible gateway). Used from Phase 3.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Daily scheduler runs inside the backend process (set false to disable)
ENABLE_SCHEDULER=true
# Assisted apply needs a VISIBLE browser on this computer; keep false when running locally.
BROWSER_HEADLESS=false
# Optional: POST notifications to a webhook (Discord/Slack-compatible JSON, ntfy, etc.)
NOTIFY_WEBHOOK_URL=

# Only used by docker-compose (PostgreSQL container password)
POSTGRES_PASSWORD=

# Set true when served over HTTPS
COOKIE_SECURE=false
